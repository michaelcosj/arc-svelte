{
	"name": "arc-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:phase5": "node tests/phase5/run.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"bits-ui": "^2.19.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/motion": "./src/lib/motion/index.ts",
		"#lib/*": "./src/lib/*",
		"#arc/*": "./src/lib/components/*/index.ts",
		"#blocks/*": "./src/lib/blocks/*/index.ts"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"description": "An independent Svelte 5 port of Arc UI, using Bits UI and native Svelte motion.",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"bits-ui",
		"ui"
	]
}
